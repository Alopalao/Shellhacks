{
  "expo": {
    "name": "BRIAN",
    "slug": "brian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brian",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.brian.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD400",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.brian.demo"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "BRIAN",
      "shortName": "BRIAN",
      "themeColor": "#FFD400",
      "backgroundColor": "#FFFFFF",
      "description": "BRIAN — Built for patients, Reliable prescription management, Integrated AI doctor, Always connected to your physician, Next-generation healthcare."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "BRIAN — Built for patients, Reliable prescription management, Integrated AI doctor, Always connected to your physician, Next-generation healthcare.",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#FFD400"
  }
}
