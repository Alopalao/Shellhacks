# App-side settings. EXPO_PUBLIC_* values are inlined into the bundle when Metro builds it: after
# changing one, restart Expo with a cleared cache (`npm run dev -- --clear` from the repo root, or
# `npx expo start -c` in app/).
# The server URL can also be changed at runtime in the app: login card "Server: … · Change", or
# Profile → Server & connection.

# App → server URL override (optional). Leave blank to auto-detect:
#   web → same host as the page, port 4000; phone (Expo Go) → the computer running `expo start`, port 4000.
# Example for a second laptop/phone pointing at a teammate's server: EXPO_PUBLIC_API_URL=http://192.168.1.23:4000
EXPO_PUBLIC_API_URL=
# Port of the BRIAN server for auto-detected URLs when it isn't 4000
# (npm run dev sets this from the root .env PORT):
EXPO_PUBLIC_API_PORT=
