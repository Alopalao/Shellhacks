# ── BRIAN environment ───────────────────────────────────────────────
# Copy to .env. Every key may stay blank: BRIAN falls back to mock/demo mode.

# Anthropic (AI doctor). Blank → evidence-only demo mode (no LLM).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# NIH / NCBI E-utilities (PubMed). Works without a key (3 req/s); a key raises the limit to 10 req/s.
NCBI_API_KEY=
NCBI_EMAIL=

# openFDA drug labels. Works without a key (lower daily limit).
OPENFDA_API_KEY=

# Server
PORT=4000
HOST=0.0.0.0
# Set to 1 to disable all outbound evidence lookups (fully offline demo).
BRIAN_EVIDENCE_OFFLINE=

# App-side settings (EXPO_PUBLIC_API_URL) live in app/.env — Expo only reads env files from the app folder.
